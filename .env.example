# Copy to .env and fill in. .env is untracked. Never commit real keys.

# Which LLM answers: haiku (default) or gemini
LLM_CONFIG=haiku

# LLM baseline (Claude Haiku 4.5, Anthropic direct)
ANTHROPIC_API_KEY=

# LLM comparison (Gemini 3.6 Flash through OpenRouter)
OPENROUTER_API_KEY=

# Speech: Deepgram Nova-3 STT and Aura-2 TTS share one key
DEEPGRAM_API_KEY=

# Telephony: Twilio trial account and its phone number in E.164 form
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Tracing: Langfuse Cloud. Base URL is https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Where the agent reaches the EHR adapter. Compose publishes it on port 3000 (ADAPTER_PORT)
EHR_ADAPTER_URL=http://localhost:3000

# Tunnel so Twilio can reach the laptop
NGROK_AUTHTOKEN=
